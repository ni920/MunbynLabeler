{
  "manifest_version": 3,
  "name": "Munbyn Labeler für Etsy",
  "version": "0.5.1",
  "description": "Übernimmt eine geöffnete Etsy-Bestellung in Munbyn Labeler.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.etsy.com/your/orders/*",
        "https://www.etsy.com/your/shops/*/orders/*",
        "https://www.etsy.com/shop-manager/orders/*"
      ],
      "js": [
        "etsy-order.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
